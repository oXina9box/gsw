# File-manager / tool artifacts — regenerable, never version these
.directory
.hallmark/
.DS_Store

# Python bytecode caches (production dirs are read-only; keep caches out of the tree)
__pycache__/
*.py[cod]

# Node (managed per-project when needed)
node_modules/

# Local credentials
.env
.env.*
!.env.example
supabase/functions/.env
# Security gate + credential hygiene (never commit secrets or audit output)
*.pem
*.key
security-audit-report/

# Supabase CLI local runtime state
supabase/.temp/
supabase/.branches/
