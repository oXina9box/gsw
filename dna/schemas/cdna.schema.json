{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gemstudio.internal/dna/schemas/cdna.schema.json",
  "title": "Character DNA (CDNA) v2 — Exhaustive Digital Twin",
  "description": "Master God-view record for a persistent character. Morphological detail lives in the 7 physical domains; v2 production blocks (wardrobe, temporal, voice_identity, casting, relationships, data_sheet) are optional but highly structured. The physical block retains legacy anchors (skin, head, eyes, nose, lips, hair) for backward compatibility with the formal CDNA schema and the Pre-Prompt Enricher.",
  "type": "object",
  "required": ["dna_id", "dna_type", "channel", "status", "metadata", "identity_core", "physical", "cinematic", "image_gen_prompt"],
  "additionalProperties": true,
  "properties": {
    "dna_id": { "type": "string", "pattern": "^CHAR-[A-F0-9]{32}$", "description": "Unique, immutable ID. PREFIX = CHAR-, suffix = first 32 uppercase hex chars of SHA-256(seed)." },
    "dna_type": { "type": "string", "const": "CDNA", "description": "DNA class discriminator." },
    "channel": { "type": "string", "description": "Producing channel (grudgenudges, howwemet, cross-channel, or custom)." },
    "seed_id": { "type": "string", "pattern": "^SEED-[A-F0-9]{32}$", "description": "ID of the deterministic seed that produced this record, if managed separately." },
    "status": { "type": "string", "enum": ["draft", "active", "archived", "retired", "deceased", "destroyed"], "description": "Production lifecycle state." },
    "created_at": { "$ref": "#/$defs/datetime" },
    "updated_at": { "$ref": "#/$defs/datetime" },

    "metadata": {
      "type": "object",
      "description": "Seed, signatures, and role flags. core_signature is the 5-trait clone-prevention signature (Gender x MST x Somatotype x Hair Type x Enneagram).",
      "additionalProperties": true,
      "properties": {
        "base_seed": { "type": "string", "description": "4-byte hex seed that drives deterministic generation." },
        "core_signature": { "type": "string", "description": "5-trait signature hashed for clone prevention." },
        "is_npc": { "type": "boolean" },
        "is_persistent": { "type": "boolean" },
        "is_shell": { "type": "boolean", "description": "A background-only NPC; visual identity only until upgraded." },
        "is_18_plus": { "type": "boolean", "description": "When true, 18+ gated morphology blocks are active." },
        "overrides": { "type": "object", "description": "Hand-authored field overrides; consume RNG cycles to keep downstream traits deterministic." }
      }
    },

    "identity_core": {
      "type": "object",
      "description": "C. Identity. The human-readable face of the character.",
      "required": ["full_name"],
      "additionalProperties": true,
      "properties": {
        "full_name": { "type": "string", "minLength": 1 },
        "preferred_pronouns": { "type": "string" },
        "gender_identity": { "type": "string", "description": "Legacy options preferred for generation parity." },
        "nickname": { "type": "string" },
        "cultural_background": { "type": "string" },
        "religious_orientation": { "type": "string" },
        "political_leaning": { "type": "string" },
        "socioeconomic_origin": { "type": "string" },
        "socioeconomic_current": { "type": "string" },
        "education": { "type": ["string", "object"] },
        "professional_title": { "type": "string" },
        "age": { "type": ["integer", "number", "null"], "minimum": 0, "description": "Age in years at the reference point." },
        "birth_date_actual": { "type": "string", "pattern": "^(?!\\s*$).+" , "description": "Real birth date. Format enforced by temporal block below." },
        "spawn_date": { "type": "string", "description": "When the character enters the universe (YYYY-MM-DD)." },
        "attitude": { "type": "string" },
        "one_liner": { "type": "string", "description": "How the character describes themselves in a sentence." }
      }
    },

    "physical": {
      "type": "object",
      "description": "D. Physical. Required legacy anchors: height_cm, weight_kg, somatotype, skin, head, eyes, nose, lips, hair. Deep, exhaustive morphology lives in the 7 domains below.",
      "required": ["height_cm", "weight_kg", "somatotype", "skin", "head", "eyes", "nose", "lips", "hair"],
      "additionalProperties": true,
      "properties": {
        "height_cm": { "type": "number", "minimum": 20, "description": "Stated height in cm." },
        "weight_kg": { "type": "number", "minimum": 1, "description": "Stated weight in kg." },
        "somatotype": { "type": "string", "description": "Ectomorph | Mesomorph | Endomorph" },
        "face_shape": { "type": "string" },
        "apparent_age": { "type": "string" },
        "handedness": { "type": "string", "enum": ["left", "right", "ambidextrous"] },
        "body_hair": { "type": "string" },
        "hormonal_presentation": { "type": "string" },
        "distinctive_marks": { "$ref": "#/$defs/distinctive_marks" },
        "eyebrows": { "type": "string" },
        "cheeks": { "type": "string" },
        "jaw_chin": { "type": "string" },
        "skin": { "type": "object", "description": "Legacy skin block. mst_level is the required master anchor (MST scale 1-10, 1 = Porcelain, 10 = Espresso).", "required": ["mst_level"], "properties": { "mst_level": { "type": "number", "minimum": 1, "maximum": 10 }, "fitzpatrick": { "type": "integer", "minimum": 1, "maximum": 6 }, "undertone": { "type": "string" }, "hex_override": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" } } },
        "head": { "type": "object", "description": "Legacy Body Mapping head object. Free-form; accepts the full legacy head fields." },
        "eyes": { "type": "object", "description": "Legacy Body Mapping eyes object." },
        "nose": { "type": "object", "description": "Legacy Body Mapping nose object." },
        "lips": { "type": "object", "description": "Legacy Body Mapping mouth/lips object." },
        "hair": { "type": "object", "description": "Legacy Follicles hair/facial-hair object." },
        "anthropometry": { "$ref": "#/$defs/anthropometry" },
        "craniofacial_morphology": { "$ref": "#/$defs/craniofacial_morphology" },
        "dermatological_profile": { "$ref": "#/$defs/dermatological_profile" },
        "trichological_profile": { "$ref": "#/$defs/trichological_profile" },
        "musculoskeletal_and_kinematic": { "$ref": "#/$defs/musculoskeletal_and_kinematic" },
        "secondary_sex_and_intimate_phenotype": { "$ref": "#/$defs/secondary_sex_and_intimate_phenotype" },
        "distinctive_asymmetries_and_anomalies": { "$ref": "#/$defs/distinctive_asymmetries_and_anomalies" }
      }
    },

    "cinematic": {
      "type": "object",
      "description": "TEMPORARY COMPATIBILITY BLOCK. Future cinematic ownership belongs to Film DNA.",
      "additionalProperties": true,
      "properties": {
        "lens_profile": { "type": "object" },
        "aperture": { "type": "string" },
        "lighting_model": { "type": "string" },
        "unconventional_angles_framing": { "type": "array" },
        "cinematography_notes": { "type": "object" }
      }
    },

    "psychological": {
      "type": "object",
      "description": "F. Psychological (legacy Deep Dive plus v2 behavioral & narrative subtext).",
      "additionalProperties": true,
      "properties": {
        "big_five": { "$ref": "#/$defs/big_five" },
        "enneagram": { "type": "object" },
        "shadow_triad": { "type": "object" },
        "defense_mechanisms": { "type": "object" },
        "attachment": { "type": "object" },
        "cognitive": { "type": "object" },
        "emotional_intelligence": { "type": "object" },
        "temperament": { "type": "object" },
        "behavioral_drivers": { "$ref": "#/$defs/behavioral_drivers" },
        "narrative_subtext": { "$ref": "#/$defs/narrative_subtext" }
      }
    },

    "speech_pattern": { "type": "object", "description": "G. Speech Pattern DNA (legacy structure).", "additionalProperties": true },

    "voice_identity": {
      "type": "object",
      "description": "H. Voice Identity — tool-agnostic. No provider is hard-coded; provider_bindings[] carries provider-specific mappings.",
      "additionalProperties": true,
      "properties": {
        "voice_name": { "type": "string" },
        "voice_status": { "type": "string" },
        "voice_owner_type": { "type": "string" },
        "voice_age_range": { "type": "string" },
        "gender_expression": { "type": "string" },
        "accent": { "type": "string" },
        "dialect_notes": { "type": "string" },
        "timbre": { "type": "string" },
        "pitch": { "type": "string" },
        "resonance": { "type": "string" },
        "tempo": { "type": "string" },
        "rhythm": { "type": "string" },
        "energy_baseline": { "type": "string" },
        "emotional_range": { "type": "string" },
        "vocal_tics": { "type": "array", "items": { "type": "string" } },
        "speech_pattern_ref": { "type": "string" },
        "native_video_voice_notes": { "type": "string" },
        "voiceover_notes": { "type": "string" },
        "adr_notes": { "type": "string" },
        "reference_audio_uris": { "type": "array", "items": { "type": "string" } },
        "voice_embedding_uri": { "type": "string" },
        "provider_bindings": { "type": "array", "items": { "$ref": "#/$defs/provider_binding" } },
        "usage_rights": { "type": "string" }
      }
    },

    "wardrobe": { "$ref": "#/$defs/wardrobe" },
    "temporal": { "$ref": "#/$defs/temporal" },
    "temporal_variants": { "type": "array", "items": { "$ref": "#/$defs/temporal_variant" } },
    "casting": { "$ref": "#/$defs/casting" },
    "relationship_graph": { "type": "object", "description": "Legacy free-form relationship graph (backward compat)." },
    "relationship_edges": { "type": "array", "description": "Structured relationship edges. Edge endpoints use the related_char_id.", "items": { "$ref": "#/$defs/relationship_edge" } },
    "location_tie": { "type": "object", "description": "Legacy location tie." },
    "episode_history": { "type": "array", "description": "Legacy episode history.", "items": { "type": "string" } },

    "data_sheet": { "$ref": "#/$defs/data_sheet" },
    "image_gen_prompt": { "type": "string", "minLength": 1, "description": "Full prompt for image/data-sheet generation." },
    "voice_gen_notes": { "type": "string", "description": "Legacy voice-gen notes. voice_identity is the future home." }
  },

  "$defs": {
    "datetime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$", "description": "Date or full ISO-8601 datetime." },

    "distinctive_marks": {
      "type": "array",
      "items": { "$ref": "#/$defs/mark_entry" }
    },
    "mark_entry": {
      "type": "object",
      "description": "A distinctive mark (tattoo, piercing, scar, birthmark, mole).",
      "required": ["mark_type", "placement", "description"],
      "properties": {
        "mark_type": { "type": "string", "enum": ["tattoo", "piercing", "scar", "birthmark", "mole", "other"] },
        "placement": { "type": "string" },
        "description": { "type": "string" }
      }
    },

    "anthropometry": {
      "type": "object",
      "description": "1. Anthropometry: cranial, torso, limb, and extremity measurements (SI units in field descriptions).",
      "properties": {
        "height_cm": { "type": "number" }, "weight_kg": { "type": "number" }, "bmi": { "type": "number" },
        "sitting_height_cm": { "type": "number" }, "leg_length_cm": { "type": "number" }, "torso_length_cm": { "type": "number" },
        "cranial_perimeter_cm": { "type": "number" }, "cranial_length_cm": { "type": "number" }, "cranial_breadth_cm": { "type": "number" }, "bizygomatic_breadth_cm": { "type": "number" },
        "biacromial_breadth_cm": { "type": "number" }, "chest_circumference_cm": { "type": "number" }, "waist_circumference_cm": { "type": "number" }, "hip_circumference_cm": { "type": "number" },
        "midarm_circumference_cm": { "type": "number" }, "thigh_circumference_cm": { "type": "number" }, "calf_circumference_cm": { "type": "number" },
        "hand_length_cm": { "type": "number" }, "hand_breadth_cm": { "type": "number" }, "foot_length_cm": { "type": "number" }, "foot_breadth_cm": { "type": "number" },
        "digit_ratio_2_4": { "type": "number" }, "digit_ratio_2_5": { "type": "number" }, "digit_ratio_2_10": { "type": "number" },
        "fingerprint_whorl_pattern": { "type": "string" }
      }
    },
    "craniofacial_morphology": {
      "type": "object",
      "description": "2. Craniofacial morphology: orbits, nasal complex, maxilla/mandible, soft tissue (units in descriptions).",
      "properties": {
        "interpupillary_distance_mm": { "type": "number" }, "palpebral_fissure_height_mm": { "type": "number" },
        "palpebral_fissure_width_mm": { "type": "number" }, "intercanthal_distance_mm": { "type": "number" },
        "nasofrontal_angle_deg": { "type": "number" }, "nasolabial_angle_deg": { "type": "number" },
        "alar_base_width_mm": { "type": "number" }, "nostril_width_mm": { "type": "number" }, "nostril_flare_pct": { "type": "number" },
        "gonial_angle_left_deg": { "type": "number" }, "gonial_angle_right_deg": { "type": "number" },
        "mandibular_symphysis_length_mm": { "type": "number" }, "mandibular_body_height_mm": { "type": "number" },
        "dental_midline_deviation_mm": { "type": "number" }, "maxillary_incisal_edge_exposure_mm": { "type": "number" },
        "buccal_fat_thickness_mm": { "type": "number" }, "nasolabial_fold_depth_mm": { "type": "number" },
        "lower_lip_thickness_mm": { "type": "number" }, "upper_lip_length_mm": { "type": "number" },
        "facial_third_ratios": { "type": "object" }
      }
    },
    "dermatological_profile": {
      "type": "object",
      "description": "3. Dermatology: tone, micro-texture, vascular/pigment, aging/wear.",
      "properties": {
        "mst_scale_level": { "type": "number", "minimum": 1, "maximum": 10 },
        "fitzpatrick": { "type": "integer", "minimum": 1, "maximum": 6 },
        "undertone": { "type": "string", "enum": ["cool_rosy", "neutral", "warm_golden", "olive"] },
        "capillary_visibility": { "type": "string" },
        "freckle_map": { "type": "object" },
        "wringle_vectors": { "type": "object" },
        "elastosis_notes": { "type": "string" },
        "subsurface_scattering_depth_mm": { "type": "number" },
        "pore_density_zones": { "type": "object" }
      }
    },
    "trichological_profile": {
      "type": "object",
      "description": "4. Trichology: scalp, strand physics, body hair.",
      "properties": {
        "scalp_follicle_density_hairs_per_cm2": { "type": "number" },
        "norwood_scale_left": { "type": "number", "minimum": 1, "maximum": 7 },
        "strand_diameter_microns": { "type": "number" },
        "strand_cross_section": { "type": "string", "enum": ["round", "oval", "flat", "ribbon"] },
        "strand_porosity": { "type": "string", "enum": ["low", "medium", "high"] },
        "body_hair_distribution": { "type": "object" }
      }
    },
    "musculoskeletal_and_kinematic": {
      "type": "object",
      "description": "5. Musculoskeletal & kinematics.",
      "properties": {
        "muscle_belly_lengths": { "type": "object" },
        "tendon_insertion_points": { "type": "object" },
        "spine_curves": { "type": "object", "properties": { "cervical_deg": { "type": "number" }, "thoracic_deg": { "type": "number" }, "lumbar_deg": { "type": "number" }, "sacral_incidence_deg": { "type": "number" } } },
        "pelvic_tilt_deg": { "type": "number" },
        "shoulder_asymmetry_deg": { "type": "number" },
        "stride_length_cm": { "type": "number" },
        "cadence_steps_per_min": { "type": "number" },
        "arm_swing_asymmetry_pct": { "type": "number" },
        "gait_parameters": { "type": "object" }
      }
    },
    "secondary_sex_and_intimate_phenotype": {
      "type": "object",
      "description": "6. Secondary sex and intimate phenotype. Contains mature-scene morphology summaries; gated by metadata.is_18_plus when active.",
      "properties": {
        "hormonal_presentation": { "type": "string", "enum": ["androgenic", "gynoid", "balanced"] },
        "android_gynoid_ratio": { "type": "number" },
        "fat_distribution_pattern": { "type": "string" },
        "breast_anatomy": { "type": "object" },
        "pelvic_gynecic_index": { "type": "number" },
        "gluteal_tilt_deg": { "type": "number" },
        "intimate_morphology_summary": { "type": "string" }
      }
    },
    "distinctive_asymmetries_and_anomalies": {
      "type": "object",
      "description": "7. Asymmetries and anomalies.",
      "properties": {
        "facial_asymmetry_vector_left": { "type": "number" },
        "facial_asymmetry_vector_right": { "type": "number" },
        "deviated_septum": { "type": "boolean" },
        "deviated_septum_direction": { "type": "string" },
        "darwin_tubercle_left": { "type": "boolean" },
        "darwin_tubercle_right": { "type": "boolean" },
        "diastema_mm": { "type": "number" },
        "rotated_incisors_severity": { "type": "string", "enum": ["none", "mild", "moderate", "severe"] },
        "anomaly_notes": { "type": "string" }
      }
    },

    "big_five": {
      "type": "object",
      "properties": {
        "openness": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "notes": { "type": "string" } } },
        "conscientiousness": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "notes": { "type": "string" } } },
        "extraversion": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "notes": { "type": "string" } } },
        "agreeableness": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "notes": { "type": "string" } } },
        "neuroticism": { "type": "object", "properties": { "score": { "type": "number", "minimum": 0, "maximum": 1 }, "notes": { "type": "string" } } }
      }
    },
    "behavioral_drivers": {
      "type": "object",
      "properties": {
        "baseline_confidence": { "type": "string" },
        "communication_style": { "type": "string" },
        "humor_style": { "type": "string" },
        "coping_mechanism": { "type": "string" },
        "trust_baseline": { "type": "string" },
        "stress_response": { "type": "object", "properties": { "mode": { "type": "string" }, "physical_tic": { "type": "string" }, "vocal_change": { "type": "string" } } }
      }
    },
    "narrative_subtext": {
      "type": "object",
      "properties": {
        "core_wound": { "type": "string" },
        "the_secret": { "type": "string" },
        "worldview": { "type": "string" },
        "blind_spot": { "type": "string" },
        "primary_trigger": { "type": "string" },
        "intimate_history": { "type": "string" },
        "romantic_blind_spot": { "type": "string" }
      }
    },

    "provider_binding": {
      "type": "object",
      "description": "A provider-agnostic voice binding. `provider` is an opaque string — no provider is hard-coded by the schema.",
      "required": ["provider", "external_voice_id"],
      "properties": {
        "provider": { "type": "string" },
        "external_voice_id": { "type": "string" },
        "model": { "type": "string" },
        "priority": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "inactive", "testing", "retired"] },
        "quality": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "wardrobe": {
      "type": "object",
      "properties": {
        "style_profile": { "type": "string" },
        "sizing": { "type": "object" },
        "default_outfit_id": { "type": "string" },
        "current_outfit_id": { "type": "string" },
        "outfits": { "type": "array", "items": { "$ref": "#/$defs/outfit" } },
        "uniforms": { "type": "array", "items": { "$ref": "#/$defs/outfit" } },
        "outfit_history": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outfit": {
      "type": "object",
      "required": ["outfit_id", "outfit_name"],
      "properties": {
        "outfit_id": { "type": "string" },
        "outfit_name": { "type": "string" },
        "garment_type": { "type": "string" },
        "one_liner": { "type": "string" },
        "pieces": { "type": "array", "items": { "$ref": "#/$defs/outfit_piece" } },
        "scene_types": { "type": "array", "items": { "type": "string" } },
        "seasonality": { "type": "string" },
        "continuity_condition_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "last_used_episode": { "type": "string" },
        "image_gen_prompt": { "type": "string" },
        "reference_uri": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "outfit_piece": {
      "type": "object",
      "required": ["piece"],
      "properties": {
        "piece": { "type": "string" },
        "description": { "type": "string" },
        "fabric": { "type": "string" },
        "fit": { "type": "string" },
        "color_hex": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "wear_level": { "type": "string" },
        "damage": { "type": "string" }
      }
    },

    "temporal": {
      "type": "object",
      "description": "Real-time clock compatibility block. aging_policy drives how age_offset_years + temporal_variants resolve at render time.",
      "required": ["aging_policy"],
      "properties": {
        "birth_date_actual": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "aging_policy": { "type": "string", "enum": ["real_time", "story_time", "frozen"] },
        "age_lock": { "type": "boolean" },
        "age_offset_years": { "type": ["integer", "number"] },
        "life_stage": { "type": "string", "enum": ["infant", "child", "teen", "adult", "middle_aged", "elderly"] },
        "temporal_notes": { "type": "string" }
      }
    },
    "temporal_variant": {
      "type": "object",
      "description": "A variant of the same character at a different age/state (young, teen, adult, old, flashback). NOT a separate character.",
      "required": ["variant_id", "label"],
      "properties": {
        "variant_id": { "type": "string" },
        "label": { "type": "string" },
        "age_range": { "type": "string" },
        "priority": { "type": "integer" },
        "use_when": { "type": "string" },
        "physical_overrides": { "type": "object" },
        "wardrobe_overrides": { "type": "object" },
        "voice_overrides": { "type": "object" },
        "image_gen_prompt_modifier": { "type": "string" }
      }
    },

    "casting": {
      "type": "object",
      "properties": {
        "casting_tier": { "type": "string", "enum": ["principal", "supporting", "persistent_npc", "background", "shell", "stub"] },
        "casting_pool": { "type": "string" },
        "is_background": { "type": "boolean" },
        "is_recurring": { "type": "boolean" },
        "is_promotable": { "type": "boolean" },
        "availability_state": { "type": "string", "enum": ["active", "alive", "dead", "missing", "incarcerated", "unknown"] },
        "first_appearance": { "type": "string" },
        "last_appearance": { "type": "string" },
        "promotion_history": { "type": "array", "items": { "type": "string" } }
      }
    },

    "relationship_edge": {
      "type": "object",
      "description": "Structured, queryable relationship between this character and another (related_char_id = CHAR-…).",
      "required": ["edge_id", "related_char_id", "relation_type"],
      "properties": {
        "edge_id": { "type": "string" },
        "related_char_id": { "type": "string", "pattern": "^CHAR-[A-F0-9]{32}$" },
        "relation_type": { "type": "string", "enum": ["parent","child","spouse","partner","sibling","friend","enemy","coworker","boss","employee","neighbor","mentor","student","lover","ex","acquaintance","owner","patron","staff","customer"] },
        "relation_subtype": { "type": "string" },
        "canonical": { "type": "boolean" },
        "current_status": { "type": "string" },
        "sentiment": { "type": "string", "enum": ["positive","neutral","negative","complicated"] },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "data_sheet": {
      "type": "object",
      "description": "Shared data-sheet contract across all DNA types.",
      "properties": {
        "status": { "type": "string", "enum": ["not_generated", "draft", "approved"] },
        "required_outputs": { "type": "array", "items": { "type": "string" } },
        "sheet_prompt_template": { "type": "string" },
        "sheet_negative_prompt": { "type": "string" },
        "reference_uri": { "type": "string" },
        "approved_version": { "type": "string" }
      }
    }
  }
}
