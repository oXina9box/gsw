NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SIGNUPS_ENABLED=false
SITE_CONTENT_APPROVED=false
EXPERIMENTAL_ORCHESTRATION=false

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
PROVIDER_SECRET_ENCRYPTION_KEY=base64-encoded-32-byte-key
PROVIDER_SECRET_KEY_VERSION=v1
# Retain old version keys here until every stored secret has been re-encrypted.
PROVIDER_SECRET_KEYS_JSON={}
PROVIDER_HOST_ALLOWLIST=api.openai.com,api.your-provider.example
PROTECTED_INFERENCE_BASE_URL=https://protected-inference.your-domain.example
PROTECTED_INFERENCE_HOST_ALLOWLIST=protected-inference.your-domain.example
PROTECTED_INFERENCE_KEY=generate-a-server-only-commercial-runtime-key
WORKER_SECRET=generate-a-long-random-value
PURGE_WORKER_SECRET=generate-a-different-long-random-value
FFMPEG_PATH=ffmpeg

STRIPE_SECRET_KEY=sk_test_or_live
STRIPE_WEBHOOK_SECRET=whsec_value
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Langfuse observability (optional — tracing silently disabled when unset)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
